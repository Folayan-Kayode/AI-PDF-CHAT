# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.
#
# Every setting in backend/app/core/config.py is listed here; a test
# (test_config.py::test_env_example_documents_every_setting) fails if the two
# ever drift apart.

# --------------------------------------------------------------------------
# Credentials (required)
# --------------------------------------------------------------------------

# Google AI Studio API key - used for embeddings
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# DeepSeek API key - used for answer generation
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Shared secret for the paid endpoints (/upload and /chat). Required: the app
# refuses to start without it, because those endpoints spend provider money.
# /health, /ready and / stay open for platform health checks.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --------------------------------------------------------------------------
# Runtime topology
# --------------------------------------------------------------------------

# Embedded ChromaDB plus a process-wide ingestion lock means exactly one
# worker. A managed platform may set WEB_CONCURRENCY for you; the app refuses
# to start if it is > 1 unless MULTI_WORKER_ACK=true, which is only correct
# after moving Chroma to server mode.
WEB_CONCURRENCY=1
MULTI_WORKER_ACK=false

# Reported by /health; the release version. Bump for a deployment.
API_VERSION=0.9.0

# Comma-separated browser origins allowed to call the API directly. Empty (the
# default) adds no CORS middleware, which is correct for the Streamlit
# server-to-server topology.
CORS_ORIGINS=

# --------------------------------------------------------------------------
# Generation (DeepSeek, OpenAI-compatible API)
# --------------------------------------------------------------------------

MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
GENERATION_TIMEOUT_SECONDS=60

# --------------------------------------------------------------------------
# Embeddings (Google)
# --------------------------------------------------------------------------

EMBEDDING_MODEL=gemini-embedding-2

# Identifies the vector space the index was built in. Bump this whenever the
# embedding model or the vector space changes, so a stale index is detected
# and reported instead of being queried.
EMBEDDING_SCHEMA_VERSION=2

# Vector space for the collection. Distances are only comparable within one
# space, so changing this requires re-uploading the document.
CHROMA_SPACE=cosine

# Chunks are embedded in paced batches so a large document does not trip the
# provider's per-minute request quota.
EMBEDDING_BATCH_SIZE=64
EMBEDDING_BATCH_DELAY_SECONDS=0.25

# A transient quota error mid-document is retried instead of discarding the
# batches that already succeeded.
EMBEDDING_MAX_RETRIES=4
EMBEDDING_RETRY_BASE_SECONDS=1.0

# Requests per minute to stay under. The pacing delay is derived from this,
# so raising it above your plan's limit will cause rate-limit errors.
EMBEDDING_REQUESTS_PER_MINUTE=90

# --------------------------------------------------------------------------
# Storage
# --------------------------------------------------------------------------

UPLOAD_DIRECTORY=uploads
CHROMA_DIRECTORY=chroma_db

# One row per ingested document: what the index was built from.
REGISTRY_PATH=registry.sqlite3

# Index writes are chunked and retried; one unbounded write can exceed what
# a single SQLite-backed transaction will commit.
CHROMA_WRITE_BATCH_SIZE=200
CHROMA_WRITE_MAX_RETRIES=3
CHROMA_WRITE_RETRY_BASE_SECONDS=0.5

# --------------------------------------------------------------------------
# Ingestion limits
# --------------------------------------------------------------------------

# Coarse guards, deliberately generous: the real constraints are upload size,
# embedding quota and ingest wall-clock, not the document's shape.
MAX_UPLOAD_SIZE_MB=25
MAX_PAGES_PER_DOCUMENT=2000
MAX_CHUNKS_PER_DOCUMENT=20000
MAX_FILENAME_LENGTH=200

# 0 rejects a concurrent upload immediately rather than queueing it, because
# ingestion can take minutes.
INGESTION_LOCK_TIMEOUT_SECONDS=0

# --------------------------------------------------------------------------
# Cost and rate limits
# --------------------------------------------------------------------------

# In-process token buckets keyed by API key, applied to /upload and /chat.
# 0 disables a limit. Uploads are bounded by volume (concurrency is already a
# 409); chats by request count.
UPLOAD_RATE_LIMIT_PER_HOUR=10
CHAT_RATE_LIMIT_PER_HOUR=120

# A daily ceiling on embedding *batches* (not chunks), checked before embedding
# starts and persisted in the registry, so one caller cannot run up an
# unbounded bill. 0 disables the ceiling. A 157-page standard is ~6 batches;
# a 658-page book is ~44.
INGEST_DAILY_EMBEDDING_BATCH_BUDGET=2000

# --------------------------------------------------------------------------
# Retrieval
# --------------------------------------------------------------------------

RETRIEVAL_TOP_K=5

# How many candidates to pull before reranking. Retrieval is cheap and
# reranking is not, so it pays to cast a wide net first.
RETRIEVAL_CANDIDATES=20

# Selection is relative to the best match for each query, because an absolute
# distance cannot work across documents: broad questions sit far from every
# chunk in a way that specific questions do not.
RETRIEVAL_RELATIVE_MARGIN=1.15
RETRIEVAL_ABSOLUTE_SLACK=0.10

# A noise floor, not a selector: it only rejects obvious nonsense when even
# the best match is unrelated. Distances are cosine, so the range is [0, 2].
RETRIEVAL_MAX_DISTANCE=1.50

MAX_CONTEXT_CHARS=12000

# A character budget alone means something very different for CJK text, where
# a character is roughly a token. Both budgets are applied.
MAX_CONTEXT_TOKENS=3000

# --------------------------------------------------------------------------
# Retrieval quality
# --------------------------------------------------------------------------

# Rewriting the question into search terms recovers questions whose phrasing
# does not match the document's wording. Costs one extra model call.
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_CHARS=200

# Reranking reorders candidates by reading them alongside the question. It
# only ever reorders, never discards, so it cannot cause an abstention.
#
# Off by default: measured on the committed evaluation set, reranking lowered
# answer accuracy and tripled cost per question, so it did not earn its call.
# Turn it on for corpora where it does; see docs/results.md.
RERANK_ENABLED=false

# Only consulted when reranking is enabled: skip the call when the best
# candidate stands out from the median of its own candidate set. Relative to
# the query rather than an absolute distance, for the same reason as the
# retrieval margins above.
RERANK_SKIP_RATIO=0.60
RERANK_SNIPPET_CHARS=300

# --------------------------------------------------------------------------
# Document profile
# --------------------------------------------------------------------------

# Some questions are about the document itself (its title, author, publisher)
# and the answer words appear nowhere in the question. The opening pages are
# read once at ingest time to build a profile chunk that can be retrieved.
# Costs one model call per document, not per question.
DOCUMENT_SUMMARY_ENABLED=true
DOCUMENT_SUMMARY_SOURCE_PAGES=10
DOCUMENT_SUMMARY_MAX_CHARS=1200

# The profile is built from the PDF's own metadata and bookmarks, which is free
# and exact. Set this true to also pay for a model summary when the document
# already carries an outline.
DOCUMENT_SUMMARY_ALWAYS=false

# The profile is supplied with every question alongside the retrieved
# passages, because vector search does not surface it for the questions it
# exists to answer ("what is the title of this book?").
DOCUMENT_PROFILE_IN_CONTEXT=true

# --------------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------------

LOG_LEVEL=INFO

# How long the optional provider probe at /ready?deep=true is cached.
HEALTH_DEEP_CACHE_SECONDS=30
