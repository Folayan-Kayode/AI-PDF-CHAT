# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# Required: Google AI Studio API key (https://aistudio.google.com/apikey)
# Used for embeddings.
GOOGLE_API_KEY=

# Required: DeepSeek API key (https://platform.deepseek.com/api_keys)
# Used for answer generation.
DEEPSEEK_API_KEY=

# DeepSeek generation model
MODEL=deepseek-chat

# Google embedding model
EMBEDDING_MODEL=gemini-embedding-2

# Maximum accepted PDF size in megabytes
MAX_UPLOAD_SIZE_MB=25
