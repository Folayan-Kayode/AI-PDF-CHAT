# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.
#
# Every setting in backend/app/core/config.py is listed here; a test
# (test_config.py::test_env_example_documents_every_setting) fails if the two
# ever drift apart.

# --------------------------------------------------------------------------
# Credentials (required)
# --------------------------------------------------------------------------

# Google AI Studio API key - used for embeddings
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# DeepSeek API key - used for answer generation
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --------------------------------------------------------------------------
# Generation (DeepSeek, OpenAI-compatible API)
# --------------------------------------------------------------------------

MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
GENERATION_TIMEOUT_SECONDS=60

# --------------------------------------------------------------------------
# Embeddings (Google)
# --------------------------------------------------------------------------

EMBEDDING_MODEL=gemini-embedding-2

# Identifies the vector space the index was built in. Bump this whenever the
# embedding model changes, so a stale index is detected instead of queried.
EMBEDDING_SCHEMA_VERSION=1

# Chunks are embedded in paced batches so a large document does not trip the
# provider's per-minute request quota.
EMBEDDING_BATCH_SIZE=64
EMBEDDING_BATCH_DELAY_SECONDS=0.25

# A transient quota error mid-document is retried instead of discarding the
# batches that already succeeded.
EMBEDDING_MAX_RETRIES=4
EMBEDDING_RETRY_BASE_SECONDS=1.0

# Requests per minute to stay under. The pacing delay is derived from this,
# so raising it above your plan's limit will cause rate-limit errors.
EMBEDDING_REQUESTS_PER_MINUTE=90

# --------------------------------------------------------------------------
# Storage
# --------------------------------------------------------------------------

UPLOAD_DIRECTORY=uploads
CHROMA_DIRECTORY=chroma_db

# Index writes are chunked and retried; one unbounded write can exceed what
# a single SQLite-backed transaction will commit.
CHROMA_WRITE_BATCH_SIZE=200
CHROMA_WRITE_MAX_RETRIES=3
CHROMA_WRITE_RETRY_BASE_SECONDS=0.5

# --------------------------------------------------------------------------
# Ingestion limits
# --------------------------------------------------------------------------

MAX_UPLOAD_SIZE_MB=25
MAX_PAGES_PER_DOCUMENT=300
MAX_CHUNKS_PER_DOCUMENT=1500
MAX_FILENAME_LENGTH=200

# 0 rejects a concurrent upload immediately rather than queueing it, because
# ingestion can take minutes.
INGESTION_LOCK_TIMEOUT_SECONDS=0

# --------------------------------------------------------------------------
# Retrieval / prompt budget
# --------------------------------------------------------------------------

RETRIEVAL_TOP_K=5
MAX_CONTEXT_CHARS=12000

# --------------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------------

LOG_LEVEL=INFO

# How long the optional provider probe at /ready?deep=true is cached.
HEALTH_DEEP_CACHE_SECONDS=30
